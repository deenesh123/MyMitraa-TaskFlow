# ==============================================================================
# MyMitraa TaskFlow — Environment Configuration Template
# ==============================================================================

# Server Runtime Settings
PORT=3000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Target Database: MongoDB (Authoritative Production Store: mymitraa_taskflow)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/mymitraa_taskflow
MONGODB_DATABASE=mymitraa_taskflow
MONGODB_USER=
MONGODB_PASSWORD=

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=mymitraa-taskflow-jwt-super-secret-key-32chars-minimum
JWT_EXPIRATION=86400

# ------------------------------------------------------------------------------
# Zoho Mail SMTP Configuration (Server-Side Integration)
# ------------------------------------------------------------------------------
# Default host: smtp.zoho.com (or smtppro.zoho.com for Zoho Workplace / Custom Domain)
# Recommended ports: 465 (SSL/TLS) or 587 (STARTTLS)
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=
ZOHO_SMTP_PASSWORD=
ZOHO_FROM_EMAIL=notifications@mymitraa.com
ZOHO_FROM_NAME="MyMitraa TaskFlow"

# Legacy / Alias variables for backwards compatibility
ZOHO_MAIL_HOST=smtp.zoho.com
ZOHO_MAIL_PORT=465
ZOHO_MAIL_USER=
ZOHO_MAIL_PASSWORD=

# ------------------------------------------------------------------------------
# Optional AI Services
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

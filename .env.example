# ==============================================================================
# MYMITRAA TASKFLOW — ENVIRONMENT VARIABLE TEMPLATE (.env.example)
# Safe placeholder examples only. Never commit real credentials to Git.
# ==============================================================================

# Active Spring Profile (dev, prod, test)
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# MongoDB Persistence Configuration (MongoDB ONLY)
# Dev target: mymitraa_taskflow_dev
# Prod target: mymitraa_taskflow
MONGODB_URI=mongodb://taskflow_app_user:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:27017/mymitraa_taskflow?authSource=mymitraa_taskflow
MONGODB_DATABASE=mymitraa_taskflow

# JWT Authentication & Expiration (Milliseconds Standard: 86400000 = 24 Hours)
JWT_SECRET=REPLACE_WITH_SECURE_256_BIT_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRATION=86400000

# File Upload Storage (Persistent VPS location)
UPLOAD_PATH=/var/data/mymitraa_uploads
APP_UPLOAD_DIR=/var/data/mymitraa_uploads

# Zoho Mail SMTPS Configuration (Port 465 SSL/SMTPS)
ZOHO_SMTP_HOST=smtppro.zoho.in
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=taskflow@mitratechgroup.com
ZOHO_SMTP_PASSWORD=REPLACE_WITH_ZOHO_16_CHAR_APP_SPECIFIC_PASSWORD
ZOHO_FROM_NAME=MY MiTRAA TaskFlow
ZOHO_FROM_EMAIL=taskflow@mitratechgroup.com

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=https://task.mitratechgroup.com

# Frontend / Vite Configuration (Client-side)
VITE_API_BASE_URL=/api
VITE_API_MODE=production
VITE_ENABLE_MOCK_FALLBACK=false
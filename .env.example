# Server & Dev Settings
HOST=0.0.0.0
PORT=3000

# Frontend API Target Configuration
# In preview mode, defaults to Express proxy routes on /api
# In production mode, set VITE_API_BASE_URL to point directly to Java Spring Boot REST API (e.g. http://localhost:8080)
VITE_API_BASE_URL=
VITE_API_MODE=preview

# Security & JWT Configuration
JWT_EXPIRATION=86400000
JWT_SECRET=

# Production MongoDB Configuration (mymitraa_taskflow)
MONGODB_DATABASE=mymitraa_taskflow
MONGODB_URI=
MONGODB_USER=
MONGODB_PASSWORD=

# Zoho Mail & SMTP Production Configuration
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=
ZOHO_SMTP_PASSWORD=
ZOHO_FROM_EMAIL=notifications@mymitraa.com
ZOHO_FROM_NAME=MyMitraa TaskFlow
ZOHO_MAIL_HOST=smtp.zoho.com
ZOHO_MAIL_PORT=465
ZOHO_MAIL_USER=
ZOHO_MAIL_PASSWORD=
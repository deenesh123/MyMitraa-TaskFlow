# ==============================================================================
# MY MiTRAA TaskFlow - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local configuration.
# Never commit credentials, passwords, or tokens to version control.

# ------------------------------------------------------------------------------
# 1. FRONTEND DEV SERVER & REVERSE PROXY (Node.js / Vite)
# ------------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# Target Spring Boot backend URL for reverse proxy (default: http://localhost:8080)
BACKEND_API_BASE_URL=http://localhost:8080

# Client API base URL (empty uses current host reverse proxy)
VITE_API_BASE_URL=

# Mode: 'production' strictly enforces live backend; 'preview' enables developer logs
VITE_API_MODE=preview

# Set to 'false' in production to enforce live backend connectivity
VITE_ENABLE_MOCK_FALLBACK=false

# ------------------------------------------------------------------------------
# 2. SPRING BOOT BACKEND (Java 17/21 & Maven)
# ------------------------------------------------------------------------------
SERVER_PORT=8080

# MongoDB sole persistence database (default: mymitraa_taskflow)
MONGODB_URI=mongodb://localhost:27017/mymitraa_taskflow
MONGODB_DATABASE=mymitraa_taskflow

# Stateless JWT Security Token (HMAC-SHA256 secret >= 256 bits)
JWT_SECRET=dGhpc2lzYXZlcnlzZWN1cmVqd3RzZWNyZXRmb3JteW1pdHJhYXRhc2tmbG93YXBwbGljYXRpb24yMDI2
JWT_EXPIRATION=86400000

# CORS Allowed Origins (Comma-separated URLs for frontend clients)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Local Document / Attachment Storage Directory
# For Windows, use forward slashes or escaped backslashes (e.g. C:/mymitraa_uploads)
UPLOAD_PATH=C:/mymitraa_uploads

# ------------------------------------------------------------------------------
# 3. ZOHO MAIL SMTP CONFIGURATION
# ------------------------------------------------------------------------------
# Host: smtp.zoho.com (Standard) or smtppro.zoho.com (Zoho Workplace custom domain)
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=user@zohomail.com
ZOHO_SMTP_PASSWORD=your-16-char-zoho-app-password
ZOHO_FROM_EMAIL=notifications@mymitraa.com
ZOHO_FROM_NAME="MY MiTRAA TaskFlow"

# ------------------------------------------------------------------------------
# 4. OPTIONAL CAPABILITIES
# ------------------------------------------------------------------------------
GEMINI_API_KEY=